# Address of the OpenBao instance the BFF talks to (server-side only).
# In the single Docker image this is the in-container OpenBao.
OPENBAO_ADDR=http://127.0.0.1:8200

# Production only: canonical public HTTPS origin (scheme + host + optional port).
# Required in production for OIDC redirects and CSRF validation; do not rely on
# client-controlled X-Forwarded-* headers.
OPENBAO_UI_PUBLIC_URL=https://bao.example.com

# Optional custom httpOnly cookie name. Leave unset to use the secure defaults:
# __Host-bao_token in production and bao_token for local HTTP development.
# BAO_COOKIE_NAME=

# --- Explicit local development mode only ---
# Use with `docker compose -f docker-compose.dev.yml up`. Keep the service
# loopback-bound and choose a local token; never commit or deploy this mode.
BAO_DEV=1
BAO_DEV_ROOT_TOKEN_ID=change-me-for-local-development
