{
  "name": "openbao-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, simple UI for OpenBao — Next.js BFF embedded alongside OpenBao in a single image.",
  "scripts": {
    "dev": "UI_DB_PATH=.data/ui.db next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "mock:bao": "node scripts/mock-openbao.mjs",
    "e2e": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-query": "5.100.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.17.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.13.10",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "playwright": "1.60.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "postcss": "8.5.12",
      "sharp": "0.35.0",
      "esbuild": "0.28.1",
      "vite": "7.3.5",
      "brace-expansion": "1.1.16",
      "js-yaml": "4.3.0"
    }
  }
}
